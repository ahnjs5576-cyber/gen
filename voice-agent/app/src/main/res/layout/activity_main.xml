<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="폰비서"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="말로 시키면 휴대폰 앱을 대신 조작해요. 예: “카톡 엄마한테 10분 늦는다고 답장해”, “유튜브에서 아이유 좋은날 틀어줘”"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- 말하기 -->
        <ImageButton
            android:id="@+id/bigMic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/mic_circle"
            android:contentDescription="말하기"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic_white" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="대기 중"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="글자로 시키기"
                android:imeOptions="actionSend"
                android:inputType="text" />

            <Button
                android:id="@+id/runButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="실행" />

            <Button
                android:id="@+id/stopButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="중지" />
        </LinearLayout>

        <!-- 준비 상태 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="처음 한 번 준비"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/micStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="① 마이크 권한" />
            <Button
                android:id="@+id/micButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="허용" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/accStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="② 접근성(화면 조작)" />
            <Button
                android:id="@+id/accButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="켜기" />
        </LinearLayout>

        <TextView
            android:id="@+id/restrictedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="접근성 목록에서 폰비서가 회색으로 막혀 있으면: 아래 [앱 정보] → 오른쪽 위 ⋮ → ‘제한된 설정 허용’을 누른 뒤 다시 켜세요."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Button
            android:id="@+id/appInfoButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 정보 열기" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/notiStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="③ 알림 접근(카톡 읽기·답장)" />
            <Button
                android:id="@+id/notiButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="켜기" />
        </LinearLayout>

        <!-- 설정 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="④ Claude API 키"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-ant-..."
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/saveKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장" />
            <Button
                android:id="@+id/testKey"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 테스트" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="모델"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/modelOpus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude Opus 5.5 (기본 · 가장 똑똑함)" />
            <RadioButton
                android:id="@+id/modelSonnet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude Sonnet 5.5 (더 저렴)" />
            <RadioButton
                android:id="@+id/modelHaiku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude Haiku 5.5 (가장 빠르고 저렴)" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="생각 깊이"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/effortGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/effortLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빠르게" />
            <RadioButton
                android:id="@+id/effortMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보통" />
            <RadioButton
                android:id="@+id/effortHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="꼼꼼하게" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confirmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="메시지 보내기 전에 소리로 확인받기" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bubbleSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="어느 화면에서나 떠 있는 마이크 버튼" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/speakSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="결과를 소리로 읽어 주기" />

        <!-- 기록 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="진행 기록"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
