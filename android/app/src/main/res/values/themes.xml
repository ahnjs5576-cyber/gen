<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the UI, so this platform theme only governs the window
      background and system bars. DayNight picks light/dark automatically.
    -->
    <style name="Theme.KatalkAssist" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
