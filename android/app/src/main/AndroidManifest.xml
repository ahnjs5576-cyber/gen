<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only so the app can show its own status notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      INTERNET is used ONLY by the optional LLM drafter (RemoteReplyDrafter),
      calling api.anthropic.com with the user's own key. The offline
      TemplateReplyDrafter needs no network, and the LLM path is off until the
      user enters a key and enables it in Settings. Nothing else leaves the
      device; notification text is never uploaded unless the user turns the LLM on.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KatalkAssist">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The core of the "read" side. Android hands this service other apps'
          notifications ONLY after the user turns it on in
          Settings > Notifications > Device & app notifications.
          BIND_NOTIFICATION_LISTENER_SERVICE is granted by the system, not us.
        -->
        <service
            android:name=".service.KatalkNotificationListener"
            android:exported="false"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
