# ── 1) 텔레그램 API (필수) ─────────────────────────────
# https://my.telegram.org → API development tools 에서 발급
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# 국제번호 형식 (예: +821012345678). 비워두면 첫 실행 때 콘솔에서 물어봄
TG_PHONE=

# ── 2) 지시용 봇 (권장) ────────────────────────────────
# @BotFather 에서 /newbot 으로 만든 봇 토큰.
# 비워두면 "저장한 메시지(Saved Messages)"에 '!'로 시작하는 메시지로 지시합니다.
BOT_TOKEN=

# ── 3) Claude (자연어 지시 처리, 선택) ─────────────────
# 비워두면 /명령어만 동작합니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── 4) 동작 옵션 ──────────────────────────────────────
# 시작할 때와 메시지 전송 후 '오프라인' 상태로 되돌림 (마지막 접속 시간 노출 최소화)
KEEP_OFFLINE=true
# 모든 대화방의 새 메시지를 로컬 DB에 기록 (false면 감시 대화방만 기록)
LOG_ALL_CHATS=true
# 브로드캐스트 채널 메시지도 기록할지
LOG_CHANNELS=false
